files['app/api/weekly-ranges/route.ts'] = `import { NextRequest, NextResponse } from 'next/server';
import { createClient } from '@/lib/supabase/server';

export async function POST(req: NextRequest) {
  const supabase = await createClient();
  const {
    data: { user },
    error: authError,
  } = await supabase.auth.getUser();

  if (authError || !user) {
    return NextResponse.json({ error: '認証が必要です' }, { status: 401 });
  }

  const body = await req.json();
  const { wordbookId, weekStartDate, rangeStart, rangeEnd, assignments } = body as {
    wordbookId: string;
    weekStartDate: string;
    rangeStart: number;
    rangeEnd: number;
    assignments: Array<{
      date: string;
      rangeStart: number | null;
      rangeEnd: number | null;
      isReviewDay: boolean;
      isRestDay?: boolean;
    }>;
  };

  if (!wordbookId || !weekStartDate || !rangeStart || !rangeEnd || !Array.isArray(assignments)) {
    return NextResponse.json({ error: 'パラメータが不足しています' }, { status: 400 });
  }

  // 1. weekly_ranges の保存 (upsert)
  const { error: wrError } = await supabase.from('weekly_ranges').upsert(
    {
      user_id: user.id,
      wordbook_id: wordbookId,
      week_start_date: weekStartDate,
      range_start: rangeStart,
      range_end: rangeEnd,
    },
    { onConflict: 'user_id,week_start_date' }
  );

  if (wrError) {
    return NextResponse.json({ error: '週間範囲の保存に失敗しました', detail: wrError.message }, { status: 500 });
  }

  // 2. daily_assignments の保存 (休みの日以外を登録/更新)
  const assignmentRows = assignments
    .filter((a) => !a.isRestDay && a.rangeStart !== null && a.rangeEnd !== null)
    .map((a) => ({
      user_id: user.id,
      wordbook_id: wordbookId,
      date: a.date,
      range_start: a.rangeStart!,
      range_end: a.rangeEnd!,
      is_review_day: a.isReviewDay,
    }));

  // 同週の既存割当を一度リセットして再登録
  const dates = assignments.map((a) => a.date);
  await supabase
    .from('daily_assignments')
    .delete()
    .eq('user_id', user.id)
    .in('date', dates);

  if (assignmentRows.length > 0) {
    const { error: daError } = await supabase.from('daily_assignments').insert(assignmentRows);
    if (daError) {
      return NextResponse.json({ error: '日次割当の保存に失敗しました', detail: daError.message }, { status: 500 });
    }
  }

  return NextResponse.json({ ok: true });
}
`;

