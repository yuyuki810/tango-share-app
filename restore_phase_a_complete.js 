  'components/weekly-range/WeeklyRangeModal.tsx': `"use client";

import { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import { calculateWeeklyAssignments, DayType } from '@/lib/assignment/calculateAssignments';
import { CycleSettingsPanel } from './CycleSettingsPanel';
import { DaySequenceEditor } from './DaySequenceEditor';
import { WeeklyPreviewPanel } from './WeeklyPreviewPanel';

interface WeeklyRangeModalProps {
  isOpen: boolean;
  onClose: () => void;
  wordbookId: string;
  wordbookTotalWords: number;
  weekStartDate: string;
  initialStartNumber?: number;
}

export function WeeklyRangeModal({
  isOpen,
  onClose,
  wordbookId,
  wordbookTotalWords,
  weekStartDate,
  initialStartNumber = 1,
}: WeeklyRangeModalProps) {
  const router = useRouter();
  const [pattern, setPattern] = useState<'5-2' | '4-3' | 'custom'>('5-2');
  const [startNumber, setStartNumber] = useState<number>(initialStartNumber);
  const [wordsPerDay, setWordsPerDay] = useState<number>(50);
  const [daySequence, setDaySequence] = useState<DayType[]>([
    'progress',
    'progress',
    'progress',
    'progress',
    'progress',
    'review',
    'review',
  ]);
  const [isSaving, setIsSaving] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const previewDays = calculateWeeklyAssignments({
    weekStartDate,
    startNumber,
    wordsPerDay,
    pattern,
    daySequence,
    totalWords: wordbookTotalWords || 2000,
  });

  const progressDays = previewDays.filter((d) => d.dayType === 'progress');
  const rangeStart = progressDays[0]?.rangeStart ?? startNumber;
  const rangeEnd = progressDays[progressDays.length - 1]?.rangeEnd ?? startNumber;

  const handleSave = async () => {
    setIsSaving(true);
    setError(null);
    try {
      const res = await fetch('/api/weekly-ranges', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          wordbookId,
          weekStartDate,
          rangeStart,
          rangeEnd,
          assignments: previewDays.map((d) => ({
            date: d.date,
            rangeStart: d.rangeStart,
            rangeEnd: d.rangeEnd,
            isReviewDay: d.dayType === 'review',
            isRestDay: d.dayType === 'rest',
          })),
        }),
      });

      if (!res.ok) {
        const body = await res.json();
        setError(body.error ?? '保存に失敗しました');
        setIsSaving(false);
        return;
      }

      router.refresh();
      onClose();
    } catch {
      setError('通信エラーが発生しました');
      setIsSaving(false);
    }
  };

  if (!isOpen) return null;

  return (
    <div className="fixed inset-0 z-50 flex items-end justify-center bg-ink/40 backdrop-blur-sm sm:items-center sm:p-4">
      <div className="max-h-[90dvh] w-full max-w-md overflow-y-auto rounded-t-3xl border-t border-line bg-paper p-5 shadow-2xl sm:rounded-3xl sm:border">
        {/* ヘッダー */}
        <div className="flex items-center justify-between pb-3 border-b border-line">
          <div>
            <h2 className="font-mincho text-lg font-bold text-ink">今週の学習目標を設定</h2>
            <p className="font-maru text-xs text-ink/60">開始日: {weekStartDate} (土曜日)</p>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="flex h-8 w-8 items-center justify-center rounded-full bg-ink/5 text-ink/60 hover:bg-ink/10"
          >
            ✕
          </button>
        </div>

        {error && (
          <div className="mt-3 rounded-xl bg-akashiito/10 p-3 text-xs text-akashiito">{error}</div>
        )}

        <div className="mt-4 space-y-6">
          <CycleSettingsPanel
            pattern={pattern}
            onPatternChange={setPattern}
            startNumber={startNumber}
            onStartNumberChange={setStartNumber}
            wordsPerDay={wordsPerDay}
            onWordsPerDayChange={setWordsPerDay}
            totalWords={wordbookTotalWords}
          />

          {pattern === 'custom' && (
            <DaySequenceEditor sequence={daySequence} onChange={setDaySequence} />
          )}

          <WeeklyPreviewPanel days={previewDays} />

          {/* 保存ボタン */}
          <div className="pt-2">
            <button
              type="button"
              disabled={isSaving}
              onClick={handleSave}
              className="min-h-[52px] w-full rounded-2xl bg-ink px-4 py-3 font-mincho text-base font-bold text-paper shadow-md transition hover:bg-ink/90 active:scale-[0.99] disabled:opacity-50"
            >
              {isSaving ? '設定を保存中...' : 'このスケジュールで確定する'}
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}
`
};

