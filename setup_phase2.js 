/**
 * 週間範囲設定UI & ナビゲーションバー干渉バグ修正スクリプト
 * 実行方法: node setup_phase2.js
 */
const fs = require("fs");
const path = require("path");

const files = {
  // 1. 週間範囲設定モーダル (z-index を z-[60] に引き上げ、スクロール領域と固定フッターを最適化)
  "components/weekly-range/WeeklyRangeModal.tsx": `"use client";

import { useState, useEffect } from "react";
import { WeeklyPreviewPanel } from "./WeeklyPreviewPanel";
import { calculateWeeklyPreview } from "@/lib/assignment/calculateWeeklyPreview";

interface WeeklyRangeModalProps {
  isOpen: boolean;
  onClose: () => void;
  userId: string;
  wordbookId: string;
  weekStartStr: string;
  onSaved?: () => void;
}

export function WeeklyRangeModal({
  isOpen,
  onClose,
  userId,
  wordbookId,
  weekStartStr,
  onSaved,
}: WeeklyRangeModalProps) {
  const [startNum, setStartNum] = useState<number>(1);
  const [endNum, setEndNum] = useState<number>(100);
  const [wordsPerDay, setWordsPerDay] = useState<number>(20);
  const [pacePreset, setPacePreset] = useState<"standard" | "speed" | "review_heavy">("standard");
  const [isSubmitting, setIsSubmitting] = useState(false);

  useEffect(() => {
    if (isOpen) {
      document.body.style.overflow = "hidden";
    } else {
      document.body.style.overflow = "";
    }
    return () => {
      document.body.style.overflow = "";
    };
  }, [isOpen]);

  if (!isOpen) return null;

  const preview = calculateWeeklyPreview({
    rangeStart: startNum,
    rangeEnd: endNum,
    wordsPerDay,
    pace: pacePreset,
    weekStartDateSaturday: weekStartStr,
  });

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (startNum > endNum) return;
    setIsSubmitting(true);

    try {
      const res = await fetch("/api/weekly-ranges", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          userId,
          wordbookId,
          weekStartDate: weekStartStr,
          rangeStart: startNum,
          rangeEnd: endNum,
          wordsPerDay,
          pace: pacePreset,
        }),
      });

      if (!res.ok) {
        const errorData = await res.json().catch(() => ({}));
        throw new Error(errorData.error || "週間範囲の保存に失敗しました");
      }

      if (onSaved) onSaved();
      onClose();
    } catch (err: any) {
      console.error("Weekly range save error:", err);
      alert(err.message || "週間範囲の保存に失敗しました。再度お試しください。");
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    // z-[60] で BottomNav (z-40) の最前面に確実にオーバーレイを展開
    <div className="fixed inset-0 z-[60] flex items-end sm:items-center justify-center">
      {/* 背景オーバーレイ */}
      <div
        className="fixed inset-0 bg-ink/40 backdrop-blur-[2px] transition-opacity"
        onClick={onClose}
      />

      {/* モーダル本体（画面高さを超えないようスクロールコンテナ化） */}
      <div className="relative w-full max-w-lg bg-paper rounded-t-2xl sm:rounded-2xl border border-line shadow-2xl z-10 max-h-[85vh] sm:max-h-[90vh] flex flex-col animate-in slide-in-from-bottom duration-200">
        {/* ドラッグインジケータ / ヘッダー */}
        <div className="pt-3 pb-2 px-6 flex flex-col items-center border-b border-line/60 flex-shrink-0">
          <div className="w-12 h-1 bg-ink/20 rounded-full mb-3 sm:hidden" />
          <div className="w-full flex items-center justify-between">
            <div>
              <span className="text-[10px] text-ink/50 font-mono tracking-wider">WEEKLY GOAL</span>
              <h2 className="font-mincho text-lg font-bold text-ink">今週の学習範囲を設定</h2>
            </div>
            <button
              type="button"
              onClick={onClose}
              className="text-ink/40 hover:text-ink p-1.5 text-base transition-colors"
              aria-label="閉じる"
            >
              ✕
            </button>
          </div>
        </div>

        {/* スクロール可能なフォーム領域 */}
        <div className="flex-1 overflow-y-auto p-5 space-y-4 min-h-0">
          {/* 単語範囲入力 */}
          <div className="space-y-1.5">
            <label className="block text-xs font-medium text-ink/70">単語の範囲（No.）</label>
            <div className="flex items-center gap-3">
              <div className="flex-1">
                <span className="text-[10px] text-ink/40 mb-1 block">開始</span>
                <input
                  type="number"
                  min={1}
                  value={startNum}
                  onChange={(e) => setStartNum(Math.max(1, parseInt(e.target.value) || 1))}
                  className="w-full px-3 py-2 border border-line rounded-lg bg-paper text-ink font-mono text-sm focus:outline-none focus:ring-1 focus:ring-ink"
                />
              </div>
              <span className="text-ink/40 pt-4">〜</span>
              <div className="flex-1">
                <span className="text-[10px] text-ink/40 mb-1 block">終了</span>
                <input
                  type="number"
                  min={startNum}
                  value={endNum}
                  onChange={(e) => setEndNum(Math.max(startNum, parseInt(e.target.value) || startNum))}
                  className="w-full px-3 py-2 border border-line rounded-lg bg-paper text-ink font-mono text-sm focus:outline-none focus:ring-1 focus:ring-ink"
                />
              </div>
            </div>
          </div>

          {/* 1日の単語数 */}
          <div className="space-y-1.5">
            <label className="block text-xs font-medium text-ink/70">1日の進める単語数</label>
            <div className="grid grid-cols-4 gap-2">
              {[10, 15, 20, 30].map((num) => (
                <button
                  key={num}
                  type="button"
                  onClick={() => setWordsPerDay(num)}
                  className={\`py-2 text-xs font-mono rounded-lg border transition-all \${
                    wordsPerDay === num
                      ? "bg-ink text-paper border-ink font-bold"
                      : "bg-paper text-ink border-line hover:bg-highlighter/10"
                  }\`}
                >
                  {num}語
                </button>
              ))}
            </div>
          </div>

          {/* プレビュー表示パネル */}
          <div className="pt-1">
            <WeeklyPreviewPanel
              days={preview?.days || []}
              dailyAssignments={preview?.dailyAssignments || []}
            />
          </div>
        </div>

        {/* 下部固定アクションフッター（BottomNavに被らない安全配置） */}
        <div className="p-4 border-t border-line bg-paper/95 rounded-b-2xl flex-shrink-0">
          <button
            type="button"
            onClick={handleSubmit}
            disabled={isSubmitting || startNum > endNum}
            className="w-full py-3 bg-ink text-paper rounded-xl font-medium text-sm hover:opacity-90 active:scale-[0.99] disabled:opacity-40 transition-all shadow-sm"
          >
            {isSubmitting ? "保存中..." : "この範囲で決定する"}
          </button>
        </div>
      </div>
    </div>
  );
}
`,

  // 2. プレビューパネル (型安全性・空配列ハンドリングの堅牢化)
  "components/weekly-range/WeeklyPreviewPanel.tsx": `"use client";

