  // 5. 週間範囲保存 API (NextRequest / NextResponse / next/server 仕様準拠)
  "app/api/weekly-ranges/route.ts": `import { NextRequest, NextResponse } from "next/server";
import { createClient } from "@/lib/supabase/server";
import { calculateWeeklyPreview } from "@/lib/assignment/calculateWeeklyPreview";

export async function POST(req: NextRequest) {
  try {
    const body = await req.json();
    const {
      userId,
      wordbookId,
      weekStartDate,
      rangeStart,
      rangeEnd,
      wordsPerDay,
      pace,
    } = body;

    if (!userId || !wordbookId || !weekStartDate || !rangeStart || !rangeEnd) {
      return NextResponse.json(
        { error: "必須項目が不足しています" },
        { status: 400 }
      );
    }

    const supabase = await createClient();

    // 1. weekly_ranges の保存・更新
    const { data: rangeData, error: rangeError } = await supabase
      .from("weekly_ranges")
      .upsert(
        {
          user_id: userId,
          wordbook_id: wordbookId,
          week_start_date: weekStartDate,
          range_start: rangeStart,
          range_end: rangeEnd,
        },
        { onConflict: "user_id,week_start_date" }
      )
      .select()
      .single();

    if (rangeError) {
      console.error("Failed to upsert weekly_range:", rangeError);
      return NextResponse.json(
        { error: "週間範囲の保存に失敗しました" },
        { status: 500 }
      );
    }

    // 2. 7日間の日次割当（daily_assignments）を計算して一括作成/更新
    const preview = calculateWeeklyPreview({
      rangeStart,
      rangeEnd,
      wordsPerDay: wordsPerDay || 20,
      pace: pace || "standard",
      weekStartDateSaturday: weekStartDate,
    });

    const dailyRows = preview.dailyAssignments.map((item) => ({
      user_id: userId,
      wordbook_id: wordbookId,
      date: item.date,
      range_start: item.rangeStart,
      range_end: item.rangeEnd,
      is_review_day: item.isReviewDay,
    }));

    // 既存の同週割当を更新
    const { error: assignError } = await supabase
      .from("daily_assignments")
      .upsert(dailyRows, { onConflict: "user_id,date" });

    if (assignError) {
      console.error("Failed to upsert daily_assignments:", assignError);
      return NextResponse.json(
        { error: "日次割当の作成に失敗しました" },
        { status: 500 }
      );
    }

    return NextResponse.json({ success: true, range: rangeData });
  } catch (error: any) {
    console.error("POST /api/weekly-ranges exception:", error);
    return NextResponse.json(
      { error: error.message || "予期しないエラーが発生しました" },
      { status: 500 }
    );
  }
}
`,
};

function main() {
  console.log("=== Fixing Weekly Range & Navigation Bar Conflict ===");
  for (const [filePath, content] of Object.entries(files)) {
    const fullPath = path.join(process.cwd(), filePath);
    const dir = path.dirname(fullPath);
    if (!fs.existsSync(dir)) {
      fs.mkdirSync(dir, { recursive: true });
    }
    fs.writeFileSync(fullPath, content.trim() + "\n", "utf8");
    console.log(`[Fixed/Updated] ${filePath}`);
  }
  console.log("=== Fix Complete! Successfully resolved layout conflict. ===");
}

main();